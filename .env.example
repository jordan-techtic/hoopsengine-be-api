APP_NAME=Hoops Engine API
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# App connects here (target / current environment DB).
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/hoops-engine-db

# Used only by scripts/migrate_staging_data.py (read-only source).
# SOURCE_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/hoops-engine-db-staging
# Optional explicit target override for migration scripts:
# TARGET_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/hoops-engine-db

SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REMEMBER_ME_TOKEN_EXPIRE_HOURS=720
RESET_TOKEN_EXPIRE_HOURS=1
RESET_TOKEN_HASH_ALGORITHM=sha256
BCRYPT_ROUNDS=12

SUPERADMIN_EMAIL=admin.hoopsengine@yopmail.com
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Hoops Engine
FRONTEND_URL=http://localhost:5173
RESET_PASSWORD_URL=http://localhost:5173/reset-password
EMAIL_VERIFICATION_OTP_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MIGRATION_PRORATION_BEHAVIOR=none

PROFILE_IMAGE_UPLOAD_DIR=storage/profile_images
PROFILE_IMAGE_MAX_SIZE_MB=2

SUPPORT_CONTACT_EMAIL=support@hoopsengine.com
SUPPORT_CONTACT_PHONE=+15558392001
SUPPORT_MESSAGE_MAX_LENGTH=500
SUPPORT_DUPLICATE_WINDOW_SECONDS=300

FAQ_INTRO_TITLE=How can we help you?
FAQ_INTRO_DESCRIPTION=Find quick answers to common questions about managing drills, subscriptions, and team sessions.
